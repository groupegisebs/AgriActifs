@model DashboardViewModel
@{
    ViewData["Title"] = "Tableau de bord";
}

<partial name="_AlertMessages" />

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="page-header-title">Tableau de bord</h1>
        <p class="page-header-subtitle">Vue d'ensemble de la plateforme et activité récente</p>
    </div>
    <div class="page-header-actions">
        <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-glow btn-sm">
            <i class="bi bi-person-plus me-1"></i> Nouvel utilisateur
        </a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="bi bi-people"></i></div>
        <div>
            <div class="stat-value">@Model.TotalUsers</div>
            <div class="stat-label">Utilisateurs</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="bi bi-person-badge"></i></div>
        <div>
            <div class="stat-value">@Model.TotalRoles</div>
            <div class="stat-label">Rôles</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon amber"><i class="bi bi-lock"></i></div>
        <div>
            <div class="stat-value">@Model.LockedUsers</div>
            <div class="stat-label">Comptes verrouillés</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon cyan"><i class="bi bi-bar-chart"></i></div>
        <div>
            <div class="stat-value">@Model.AvailableReports</div>
            <div class="stat-label">Rapports disponibles</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="gise-card h-100">
            <div class="gise-card-header">
                <h3><i class="bi bi-box-arrow-in-right me-2 text-primary"></i> Dernières connexions</h3>
            </div>
            <div class="gise-card-body p-0">
                <div class="gise-table-wrap">
                    <table class="gise-table">
                        <thead><tr><th>Action</th><th>Utilisateur</th><th>Date</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.RecentLogins)
                        {
                            <tr>
                                <td><span class="badge text-bg-light text-dark">@item.Action</span></td>
                                <td>@item.UserName</td>
                                <td class="text-muted small">@item.CreatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="gise-card h-100">
            <div class="gise-card-header">
                <h3><i class="bi bi-activity me-2 text-primary"></i> Actions récentes</h3>
            </div>
            <div class="gise-card-body p-0">
                <div class="gise-table-wrap">
                    <table class="gise-table">
                        <thead><tr><th>Action</th><th>Utilisateur</th><th>Date</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.RecentActions)
                        {
                            <tr>
                                <td><span class="badge text-bg-light text-dark">@item.Action</span></td>
                                <td>@item.UserName</td>
                                <td class="text-muted small">@item.CreatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
