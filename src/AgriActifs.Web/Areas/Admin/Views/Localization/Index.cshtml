@model IReadOnlyList<string>
@{
    ViewData["Title"] = "Traductions";
}

<h1>Traductions YAML</h1>

<div class="list-group">
@foreach (var culture in Model)
{
    <div class="list-group-item d-flex justify-content-between align-items-center">
        <span>@culture</span>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-culture="@culture" class="btn btn-sm btn-outline-primary">Éditer</a>
            <a asp-action="Download" asp-route-culture="@culture" class="btn btn-sm btn-outline-secondary">Télécharger</a>
        </div>
    </div>
}
</div>
