@model IReadOnlyList<PermissionRowViewModel>
@{
    ViewData["Title"] = $"Permissions — {ViewBag.RoleName}";
    var roleId = (string)ViewBag.RoleId;
    var categories = (IReadOnlyList<PermissionCategoryGroupViewModel>)ViewBag.Categories;
    var grantedIds = (HashSet<int>)ViewBag.GrantedIds;
}

<h1>Permissions du rôle : @ViewBag.RoleName</h1>

<form asp-action="EditRole" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="RoleId" value="@roleId" />

    @foreach (var category in categories)
    {
        <h4 class="mt-4">@category.Category</h4>
        <div class="row">
            @foreach (var perm in category.Permissions)
            {
                <div class="col-md-6 col-lg-4 mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="GrantedPermissionIds" value="@perm.PermissionId"
                               id="perm_@perm.PermissionId"
                               checked="@grantedIds.Contains(perm.PermissionId)" />
                        <label class="form-check-label" for="perm_@perm.PermissionId">
                            @perm.DisplayName
                            <small class="text-muted d-block">@perm.Code</small>
                        </label>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </div>
</form>
