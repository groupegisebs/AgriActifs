@model IReadOnlyList<RoleListItemViewModel>
@{
    ViewData["Title"] = "Rôles";
}

<partial name="_AlertMessages" />

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="page-header-title">Rôles</h1>
        <p class="page-header-subtitle">@Model.Count rôle(s) — permissions configurables en BD</p>
    </div>
    <div class="page-header-actions">
        <a asp-area="Admin" asp-controller="PermissionMatrix" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-grid-3x3-gap me-1"></i> Matrice habilitations
        </a>
        <a asp-action="Create" class="btn btn-glow btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Nouveau rôle
        </a>
    </div>
</div>

<div class="gise-card">
    <div class="gise-card-body p-0">
        <div class="gise-table-wrap">
            <table class="gise-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Utilisateurs</th>
                        <th>Système</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td><strong>@role.Name</strong></td>
                        <td class="text-muted">@role.Description</td>
                        <td><span class="badge text-bg-light text-dark">@role.UserCount</span></td>
                        <td>
                            @if (role.IsSystemRole)
                            {
                                <span class="badge text-bg-primary">Système</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light text-dark">Personnalisé</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="PermissionMatrix" asp-action="Index" class="btn btn-sm btn-outline-success" title="Matrice habilitations">
                                <i class="bi bi-check2-square"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary" title="Modifier">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
