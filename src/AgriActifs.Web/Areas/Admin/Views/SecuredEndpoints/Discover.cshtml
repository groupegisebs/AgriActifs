@model IReadOnlyList<AgriActifs.Web.Services.Interfaces.DiscoveredMvcEndpoint>
@{
    ViewData["Title"] = "Endpoints non mappés";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Endpoints MVC sans mapping BD</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-success">Tous les endpoints détectés sont mappés.</div>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Area</th>
                <th>Controller</th>
                <th>Action</th>
                <th>HTTP</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Area ?? "—")</td>
                    <td>@item.Controller</td>
                    <td>@item.Action</td>
                    <td>@item.HttpMethod</td>
                    <td>
                        <a asp-action="Create"
                           asp-route-area="@item.Area"
                           asp-route-controller="@item.Controller"
                           asp-route-action="@item.Action"
                           asp-route-httpMethod="@item.HttpMethod"
                           class="btn btn-sm btn-primary">Mapper</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
