@model UserRolesViewModel
@{
    ViewData["Title"] = "Rôles utilisateur";
}

<h1>Rôles de @Model.Email</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" value="@Model.UserId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @for (var i = 0; i < Model.Roles.Count; i++)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="selectedRoles" value="@Model.Roles[i].RoleName" checked="@Model.Roles[i].IsSelected" />
            <label class="form-check-label">@Model.Roles[i].RoleName</label>
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
    <a asp-controller="Users" asp-action="Index" class="btn btn-secondary mt-3">Retour</a>
</form>
