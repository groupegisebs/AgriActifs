@model ActifAgricole
@{ ViewData["Title"] = Model.Name; }
<div class="container py-4" style="max-width:800px">
    <h1 class="h3">@Model.Name <span class="badge text-bg-secondary">@Model.InternalCode</span></h1>
    <dl class="row mt-3">
        <dt class="col-sm-4">Catégorie</dt><dd class="col-sm-8">@Model.Categorie</dd>
        <dt class="col-sm-4">Statut</dt><dd class="col-sm-8">@Model.Statut</dd>
        <dt class="col-sm-4">Marque / modèle</dt><dd class="col-sm-8">@Model.Brand @Model.Model (@Model.Year)</dd>
        <dt class="col-sm-4">N° série</dt><dd class="col-sm-8">@Model.SerialNumber</dd>
        <dt class="col-sm-4">Valeur acquisition</dt><dd class="col-sm-8">@Model.AcquisitionValue.ToString("C")</dd>
        <dt class="col-sm-4">Parcelle</dt><dd class="col-sm-8">@(Model.Parcelle?.Name ?? "—")</dd>
        <dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@Model.Notes</dd>
    </dl>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Modifier</a>
    <a class="btn btn-link" asp-action="Index">Retour</a>
</div>
