@model ActifDetailsViewModel
@{
    ViewData["Title"] = Model.Actif.Name;
    var a = Model.Actif;
}
<div class="container py-4" style="max-width:960px">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <p class="text-muted small mb-1">@a.InternalCode · @a.Categorie</p>
            <h1 class="h3 mb-1">@a.Name</h1>
            <span class="badge text-bg-@(a.Statut switch {
                ActifStatut.EnService => "success",
                ActifStatut.EnPanne => "danger",
                ActifStatut.EnMaintenance => "warning",
                ActifStatut.HorsService => "secondary",
                _ => "light"
            })">@a.Statut</span>
            @if (Model.ServiceDueByHours || Model.ServiceDueByDate)
            {
                <span class="badge text-bg-warning">Entretien dû</span>
            }
            @if (Model.WarrantyExpiring)
            {
                <span class="badge text-bg-info">Garantie bientôt</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-controller="Maintenance" asp-action="Create" asp-route-actifId="@a.Id">Intervention</a>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@a.Id">Modifier</a>
            <a class="btn btn-link" asp-action="Index">Retour</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="border rounded p-3 h-100 text-center bg-light">
                @if (!string.IsNullOrEmpty(a.PhotoUrl))
                {
                    <img src="@a.PhotoUrl" alt="@a.Name" class="img-fluid rounded mb-2" style="max-height:120px" />
                }
                else
                {
                    <i class="bi bi-truck display-4 text-muted"></i>
                }
                <div class="small text-muted mt-2">QR: @(a.QrPayload ?? a.InternalCode)</div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="row g-2">
                <div class="col-sm-4"><div class="border rounded p-2"><div class="small text-muted">Localisation</div><strong>@(a.Building ?? a.LocationNote ?? a.Parcelle?.Name ?? "—")</strong></div></div>
                <div class="col-sm-4"><div class="border rounded p-2"><div class="small text-muted">Heures moteur</div><strong>@(a.EngineHours?.ToString("N0") ?? "—")</strong></div></div>
                <div class="col-sm-4"><div class="border rounded p-2"><div class="small text-muted">Valeur</div><strong>@a.AcquisitionValue.ToString("C0")</strong></div></div>
                <div class="col-sm-4"><div class="border rounded p-2"><div class="small text-muted">Garantie</div><strong>@(a.WarrantyEndDate?.ToString("yyyy-MM-dd") ?? "—")</strong></div></div>
                <div class="col-sm-4"><div class="border rounded p-2"><div class="small text-muted">Prochain service</div><strong>@(a.NextServiceDate?.ToString("yyyy-MM-dd") ?? "—") @(a.NextServiceHours is not null ? $" / {a.NextServiceHours:N0} h" : "")</strong></div></div>
                <div class="col-sm-4"><div class="border rounded p-2"><div class="small text-muted">Coût maint. cumulé</div><strong>@Model.CoutMaintenanceTotal.ToString("C0")</strong></div></div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-info" type="button">Informations</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-maint" type="button">Maintenance</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-hist" type="button">Historique</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pieces" type="button">Pièces</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-couts" type="button">Coûts</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-docs" type="button">Documents</button></li>
    </ul>
    <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white">
        <div class="tab-pane fade show active" id="tab-info">
            <dl class="row mb-0">
                <dt class="col-sm-3">Marque / modèle</dt><dd class="col-sm-9">@a.Brand @a.Model (@a.Year)</dd>
                <dt class="col-sm-3">Sous-catégorie</dt><dd class="col-sm-9">@(a.SubCategory ?? "—")</dd>
                <dt class="col-sm-3">N° série</dt><dd class="col-sm-9">@(a.SerialNumber ?? "—")</dd>
                <dt class="col-sm-3">Acquisition</dt><dd class="col-sm-9">@(a.AcquisitionDate?.ToString("yyyy-MM-dd") ?? "—") · @a.AcquisitionValue.ToString("C")</dd>
                <dt class="col-sm-3">Durée utile</dt><dd class="col-sm-9">@(a.UsefulLifeYears?.ToString() ?? "—") ans · résiduel @a.ResidualValue.ToString("C")</dd>
                <dt class="col-sm-3">Parcelle</dt><dd class="col-sm-9">@(a.Parcelle?.Name ?? "—")</dd>
                <dt class="col-sm-3">GPS</dt><dd class="col-sm-9">@(a.GpsLat is not null && a.GpsLng is not null ? $"{a.GpsLat}, {a.GpsLng}" : "—")</dd>
                <dt class="col-sm-3">Fournisseur</dt><dd class="col-sm-9">@(a.Fournisseur?.Name ?? "—")</dd>
                <dt class="col-sm-3">Odomètre</dt><dd class="col-sm-9">@(a.OdometerKm?.ToString("N0") ?? "—") km</dd>
                <dt class="col-sm-3">Dernière utilisation</dt><dd class="col-sm-9">@(a.LastUsedAt?.ToString("yyyy-MM-dd") ?? "—")</dd>
                <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@(a.Notes ?? "—")</dd>
            </dl>
        </div>
        <div class="tab-pane fade" id="tab-maint">
            <p class="small text-muted">Heures actuelles : @(a.EngineHours?.ToString("N0") ?? "—") · Seuil service : @(a.NextServiceHours?.ToString("N0") ?? "—") · Date : @(a.NextServiceDate?.ToString("yyyy-MM-dd") ?? "—")</p>
            <a class="btn btn-sm btn-primary mb-3" asp-controller="Maintenance" asp-action="Create" asp-route-actifId="@a.Id">Planifier</a>
            @if (Model.Interventions.Any(i => i.Statut is InterventionStatut.Ouverte or InterventionStatut.EnCours))
            {
                <ul class="list-group">
                    @foreach (var i in Model.Interventions.Where(x => x.Statut is InterventionStatut.Ouverte or InterventionStatut.EnCours))
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@i.Title <span class="text-muted">(@i.Type)</span></span>
                            <span>@i.PlannedDate.ToString("yyyy-MM-dd") · @i.Statut</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">Aucune intervention ouverte.</p>
            }
        </div>
        <div class="tab-pane fade" id="tab-hist">
            @if (Model.Interventions.Count == 0)
            {
                <p class="text-muted mb-0">Aucun historique.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>Date</th><th>Titre</th><th>Type</th><th>Statut</th><th>Coût</th></tr></thead>
                    <tbody>
                    @foreach (var i in Model.Interventions)
                    {
                        <tr>
                            <td>@i.PlannedDate.ToString("yyyy-MM-dd")</td>
                            <td>@i.Title</td>
                            <td>@i.Type</td>
                            <td>@i.Statut</td>
                            <td>@((i.LaborCost + i.PartsCost).ToString("C"))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
        <div class="tab-pane fade" id="tab-pieces">
            @{
                var pieces = Model.Interventions.SelectMany(i => i.Pieces).ToList();
            }
            @if (pieces.Count == 0)
            {
                <p class="text-muted mb-0">Aucune pièce liée aux interventions.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var p in pieces)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@(p.StockArticle?.Name ?? $"#{p.StockArticleId}")</span>
                            <span>@p.Quantity @(p.Deducted ? "✓ déduit" : "")</span>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="tab-pane fade" id="tab-couts">
            <dl class="row mb-0">
                <dt class="col-sm-4">Acquisition</dt><dd class="col-sm-8">@a.AcquisitionValue.ToString("C")</dd>
                <dt class="col-sm-4">Maintenance cumulée</dt><dd class="col-sm-8">@Model.CoutMaintenanceTotal.ToString("C")</dd>
                <dt class="col-sm-4">Main-d'œuvre</dt><dd class="col-sm-8">@Model.Interventions.Sum(i => i.LaborCost).ToString("C")</dd>
                <dt class="col-sm-4">Pièces</dt><dd class="col-sm-8">@Model.Interventions.Sum(i => i.PartsCost).ToString("C")</dd>
            </dl>
        </div>
        <div class="tab-pane fade" id="tab-docs">
            <a class="btn btn-sm btn-outline-primary mb-3" asp-controller="Documents" asp-action="Create" asp-route-actifId="@a.Id">+ Document</a>
            @if (Model.Documents.Count == 0)
            {
                <p class="text-muted mb-0">Aucun document lié.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var d in Model.Documents)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>
                                <span class="badge text-bg-light">@d.Categorie</span>
                                @if (!string.IsNullOrEmpty(d.FileUrl))
                                { <a href="@d.FileUrl" target="_blank" rel="noopener">@d.Title</a> }
                                else { @d.Title }
                            </span>
                            <span class="small text-muted">@d.DocumentDate.ToString("yyyy-MM-dd")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
