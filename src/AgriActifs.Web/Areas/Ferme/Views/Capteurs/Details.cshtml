@model CapteurDetailsViewModel
@{
    ViewData["Title"] = Model.Capteur.Name;
    var c = Model.Capteur;
}
<div class="container py-4" style="max-width:800px">
    <div class="d-flex justify-content-between mb-3">
        <div>
            <h1 class="h3">@c.Name <span class="badge text-bg-secondary">@c.Code</span></h1>
            <p class="text-muted">@c.Type · @(c.Parcelle?.Name ?? c.Actif?.Name ?? "—")</p>
        </div>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Modifier</a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="border rounded p-3"><div class="small text-muted">Dernière valeur</div><strong class="fs-4">@(c.LastValue?.ToString("0.##") ?? "—") @c.Unit</strong></div></div>
        <div class="col-md-4"><div class="border rounded p-3"><div class="small text-muted">État</div><strong>@c.Statut</strong></div></div>
        <div class="col-md-4"><div class="border rounded p-3"><div class="small text-muted">Seuils</div><strong>@(c.AlertMin?.ToString("0.##") ?? "—") … @(c.AlertMax?.ToString("0.##") ?? "—")</strong></div></div>
    </div>
    <form asp-action="AddLecture" method="post" class="row g-2 mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@c.Id" />
        <div class="col-md-4"><input name="value" type="number" step="0.001" class="form-control" placeholder="Nouvelle lecture" required /></div>
        <div class="col-md-5"><input name="notes" class="form-control" placeholder="Notes" /></div>
        <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Enregistrer</button></div>
    </form>
    <h2 class="h6">Historique</h2>
    <table class="table table-sm">
        <thead><tr><th>Date</th><th>Valeur</th><th>Notes</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lectures)
        {
            <tr>
                <td>@l.RecordedAt.ToLocalTime().ToString("g")</td>
                <td>@l.Value.ToString("0.###") @c.Unit</td>
                <td>@(l.Notes ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
