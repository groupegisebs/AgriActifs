@model IEnumerable<Fournisseur>
@{ ViewData["Title"] = "Fournisseurs"; }
<div class="container py-4">
    <div class="d-flex justify-content-between mb-3">
        <h1 class="h3">Fournisseurs</h1>
        <a class="btn btn-primary" asp-action="Create">Nouveau</a>
    </div>
    <table class="table table-striped">
        <thead><tr><th>Nom</th><th>Contact</th><th>Email</th><th>Téléphone</th><th></th></tr></thead>
        <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td>@f.Name</td><td>@f.ContactName</td><td>@f.Email</td><td>@f.Phone</td>
                <td><a asp-action="Edit" asp-route-id="@f.Id">Modifier</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
