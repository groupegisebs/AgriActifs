@model InterventionFormViewModel
@{
    ViewData["Title"] = Model.Intervention.Id == 0 ? "Nouvelle intervention" : "Modifier intervention";
    var i = Model.Intervention;
}
<div class="container py-4" style="max-width:780px">
    <h1 class="h3 mb-3">@ViewData["Title"]</h1>
    <form method="post">
        <input type="hidden" asp-for="Intervention.Id" />
        <input type="hidden" asp-for="Intervention.ExploitationId" />
        <div class="mb-3">
            <label asp-for="Intervention.Title" class="form-label">Titre</label>
            <input asp-for="Intervention.Title" class="form-control" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Intervention.Type" class="form-label">Type</label>
                <select asp-for="Intervention.Type" class="form-select" asp-items="Html.GetEnumSelectList<InterventionType>()"></select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Intervention.Statut" class="form-label">État</label>
                <select asp-for="Intervention.Statut" class="form-select" asp-items="Html.GetEnumSelectList<InterventionStatut>()"></select>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Intervention.ActifAgricoleId" class="form-label">Actif</label>
            <select asp-for="Intervention.ActifAgricoleId" class="form-select" asp-items="ViewBag.Actifs"><option value="">—</option></select>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Intervention.Priorite" class="form-label">Priorité</label>
                <select asp-for="Intervention.Priorite" class="form-select" asp-items="Html.GetEnumSelectList<InterventionPriorite>()"></select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Intervention.AssignedToName" class="form-label">Technicien</label>
                <input asp-for="Intervention.AssignedToName" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Intervention.PlannedDate" class="form-label">Date prévue</label>
            <input asp-for="Intervention.PlannedDate" type="date" class="form-control" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Intervention.LaborCost" class="form-label">Main-d'œuvre</label>
                <input asp-for="Intervention.LaborCost" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Intervention.PartsCost" class="form-label">Coût pièces (manuel)</label>
                <input asp-for="Intervention.PartsCost" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Intervention.Description" class="form-label">Description</label>
            <textarea asp-for="Intervention.Description" class="form-control"></textarea>
        </div>

        <h2 class="h6">Pièces stock (déduites à la clôture)</h2>
        @for (var idx = 0; idx < Model.PieceLines.Count; idx++)
        {
            <div class="row g-2 mb-2">
                <div class="col-md-8">
                    <select asp-for="PieceLines[idx].StockArticleId" class="form-select" asp-items="ViewBag.Pieces">
                        <option value="">— article —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <input asp-for="PieceLines[idx].Quantity" class="form-control" placeholder="Qté" />
                </div>
            </div>
        }
        <p class="small text-muted">Ajoutez des lignes supplémentaires en réouvrant l’édition après enregistrement (MVP : 1–N lignes déjà présentes).</p>

        @if (i.Id != 0)
        {
            <div class="mb-3">
                <label asp-for="Intervention.Report" class="form-label">Rapport</label>
                <textarea asp-for="Intervention.Report" class="form-control"></textarea>
            </div>
        }

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn btn-link">Annuler</a>
    </form>
</div>
