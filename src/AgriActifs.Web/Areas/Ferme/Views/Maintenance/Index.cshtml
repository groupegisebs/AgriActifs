@model IEnumerable<InterventionMaintenance>
@{ ViewData["Title"] = "Maintenance"; }
<div class="container py-4">
    <div class="d-flex justify-content-between mb-3">
        <h1 class="h3">Maintenance</h1>
        <a class="btn btn-primary" asp-action="Create">Nouvelle intervention</a>
    </div>
    <table class="table table-striped">
        <thead><tr><th>Date</th><th>Titre</th><th>Actif</th><th>Type</th><th>Statut</th><th>Coût</th><th></th></tr></thead>
        <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.PlannedDate.ToString("yyyy-MM-dd")</td>
                <td>@i.Title</td>
                <td>@(i.Actif?.Name ?? "—")</td>
                <td>@i.Type</td>
                <td>@i.Statut</td>
                <td>@((i.LaborCost + i.PartsCost).ToString("C"))</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@i.Id">Modifier</a>
                    @if (i.Statut is InterventionStatut.Ouverte or InterventionStatut.EnCours)
                    {
                        <form asp-action="Close" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@i.Id" />
                            <button type="submit" class="btn btn-link btn-sm p-0">Clôturer</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
