@model IEnumerable<FermeNotification>
@{ ViewData["Title"] = "Notifications"; }
<div class="container py-4" style="max-width:800px">
    <div class="d-flex justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-0">Notifications</h1>
            <p class="text-muted small mb-0">@ViewBag.Unread non lue(s)</p>
        </div>
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary btn-sm">Tout marquer lu</button>
        </form>
    </div>
    @if (!Model.Any())
    {
        <p class="text-muted">Aucune notification.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var n in Model)
            {
                var tone = n.Severity switch
                {
                    NotificationSeverity.Danger => "danger",
                    NotificationSeverity.Warning => "warning",
                    NotificationSeverity.Success => "success",
                    _ => "info"
                };
                <li class="list-group-item d-flex justify-content-between align-items-start @(n.IsRead ? "opacity-75" : null)">
                    <div>
                        <span class="badge text-bg-@tone me-1">●</span>
                        <strong>@n.Title</strong>
                        <div class="small">@n.Message</div>
                        <div class="small text-muted">@n.CreatedAt.ToLocalTime().ToString("g")</div>
                        @if (!string.IsNullOrEmpty(n.LinkController))
                        {
                            <a class="small" asp-controller="@n.LinkController" asp-action="@(n.LinkAction ?? "Index")" asp-route-id="@n.LinkId">Ouvrir</a>
                        }
                    </div>
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkRead" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button class="btn btn-link btn-sm">Lu</button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</div>
