@model ParcelleDetailsViewModel
@{
    ViewData["Title"] = Model.Parcelle.Name;
    var p = Model.Parcelle;
}
<div class="container py-4" style="max-width:960px">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <p class="text-muted small mb-1">@p.Code</p>
            <h1 class="h3">@p.Name</h1>
        </div>
        <div>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@p.Id">Modifier</a>
            <a class="btn btn-link" asp-action="Index">Retour</a>
        </div>
    </div>

    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#p-info" type="button">Informations</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#p-culture" type="button">Culture</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#p-hist" type="button">Historique</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#p-actifs" type="button">Actifs utilisés</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#p-interv" type="button">Interventions</button></li>
    </ul>
    <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white">
        <div class="tab-pane fade show active" id="p-info">
            <dl class="row mb-0">
                <dt class="col-sm-3">Superficie</dt><dd class="col-sm-9">@p.AreaHa ha</dd>
                <dt class="col-sm-3">Type de sol</dt><dd class="col-sm-9">@(p.SoilType ?? "—")</dd>
                <dt class="col-sm-3">Irrigation</dt><dd class="col-sm-9">@(p.HasIrrigation ? "Oui" : "Non")</dd>
                <dt class="col-sm-3">État</dt><dd class="col-sm-9">@p.Etat</dd>
                <dt class="col-sm-3">Chef</dt><dd class="col-sm-9">@(p.ResponsibleName ?? "—")</dd>
                <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@(p.Notes ?? "—")</dd>
            </dl>
        </div>
        <div class="tab-pane fade" id="p-culture">
            <dl class="row mb-0">
                <dt class="col-sm-3">Culture actuelle</dt><dd class="col-sm-9">@(p.CurrentCulture ?? "—")</dd>
                <dt class="col-sm-3">Culture précédente</dt><dd class="col-sm-9">@(p.PreviousCulture ?? "—")</dd>
                <dt class="col-sm-3">Culture prévue</dt><dd class="col-sm-9">@(p.PlannedCulture ?? "—")</dd>
                <dt class="col-sm-3">Semis</dt><dd class="col-sm-9">@(p.SowingDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                <dt class="col-sm-3">Récolte</dt><dd class="col-sm-9">@(p.HarvestDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                <dt class="col-sm-3">Rendement estimé</dt><dd class="col-sm-9">@(p.EstimatedYieldPerHa is not null ? $"{p.EstimatedYieldPerHa:0.##} t/ha" : "—")</dd>
                <dt class="col-sm-3">Rendement réel</dt><dd class="col-sm-9">@(p.ActualYieldPerHa is not null ? $"{p.ActualYieldPerHa:0.##} t/ha" : "—")</dd>
            </dl>
        </div>
        <div class="tab-pane fade" id="p-hist">
            @if (p.Assolements.Count == 0)
            {
                <p class="text-muted mb-0">Aucun assolement enregistré.</p>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>Saison</th><th>Culture</th><th>Rendement</th></tr></thead>
                    <tbody>
                    @foreach (var a in p.Assolements.OrderByDescending(x => x.Season))
                    {
                        <tr>
                            <td>@a.Season</td>
                            <td>@a.Culture</td>
                            <td>@(a.YieldPerHa is not null ? $"{a.YieldPerHa:0.##} t/ha" : "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
        <div class="tab-pane fade" id="p-actifs">
            @if (Model.Actifs.Count == 0)
            {
                <p class="text-muted mb-0">Aucun actif affecté.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var a in Model.Actifs)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <a asp-controller="Actifs" asp-action="Details" asp-route-id="@a.Id">@a.InternalCode — @a.Name</a>
                            <span class="badge text-bg-secondary">@a.Statut</span>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="tab-pane fade" id="p-interv">
            @if (Model.Interventions.Count == 0)
            {
                <p class="text-muted mb-0">Aucune intervention sur les actifs de cette parcelle.</p>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>Date</th><th>Titre</th><th>Actif</th><th>Statut</th></tr></thead>
                    <tbody>
                    @foreach (var i in Model.Interventions)
                    {
                        <tr>
                            <td>@i.PlannedDate.ToString("yyyy-MM-dd")</td>
                            <td>@i.Title</td>
                            <td>@(i.Actif?.Name ?? "—")</td>
                            <td>@i.Statut</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
