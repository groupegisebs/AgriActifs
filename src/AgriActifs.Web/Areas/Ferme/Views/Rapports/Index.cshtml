@model RapportsFermeViewModel
@{ ViewData["Title"] = "Rapports & analyses"; }
<div class="container py-4">
    <div class="d-flex justify-content-between mb-3">
        <h1 class="h3">Rapports</h1>
        <a class="btn btn-outline-secondary" asp-action="ExportTco">Export TCO CSV</a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Valeur du parc</div><strong>@Model.ValeurParc.ToString("C0")</strong></div></div>
        <div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Maint. année</div><strong>@Model.CoutMaintenanceAnnee.ToString("C0")</strong></div></div>
        <div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Pannes</div><strong>@Model.Pannes</strong></div></div>
        <div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Interventions clôturées</div><strong>@Model.InterventionsCloturees</strong></div></div>
    </div>
    <h2 class="h5">TCO par actif</h2>
    <p class="text-muted small">Coût total de possession ≈ acquisition + maintenance − résiduel.</p>
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead><tr><th>Code</th><th>Nom</th><th>Acquisition</th><th>Maint.</th><th>Résiduel</th><th>TCO</th><th>Annualisé</th></tr></thead>
            <tbody>
            @foreach (var r in Model.TcoRows)
            {
                <tr>
                    <td><a asp-controller="Actifs" asp-action="Details" asp-route-id="@r.Id">@r.Code</a></td>
                    <td>@r.Name</td>
                    <td>@r.Acquisition.ToString("C0")</td>
                    <td>@r.Maintenance.ToString("C0")</td>
                    <td>@r.Residual.ToString("C0")</td>
                    <td><strong>@r.Tco.ToString("C0")</strong></td>
                    <td>@r.Annualized.ToString("C0")/an</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
