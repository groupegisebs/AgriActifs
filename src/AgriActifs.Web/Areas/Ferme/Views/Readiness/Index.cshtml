@model ReadinessViewModel
@{ ViewData["Title"] = "Readiness agricole"; }
<div class="container py-4">
    <div class="d-flex justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-0">Calendrier readiness</h1>
            <p class="text-muted small mb-0">21 prochains jours — équipements vs semis / récolte / travaux</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge text-bg-success">Prêt @Model.ReadyCount</span>
            <span class="badge text-bg-danger">Bloqué / risque @Model.BlockedCount</span>
        </div>
    </div>
    @if (Model.Items.Count == 0)
    {
        <p class="text-muted">Aucune activité planifiée sur l’horizon.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead><tr><th>Date</th><th>Activité</th><th>Type</th><th>Parcelle</th><th>Équipement</th><th>Statut</th><th>Détail</th></tr></thead>
            <tbody>
            @foreach (var i in Model.Items)
            {
                <tr class="@(!i.Ready ? "table-warning" : null)">
                    <td>@i.PlannedDate.ToString("yyyy-MM-dd")</td>
                    <td><a asp-controller="Activites" asp-action="Edit" asp-route-id="@i.ActiviteId">@i.Title</a></td>
                    <td>@i.Type</td>
                    <td>@(i.Parcelle ?? "—")</td>
                    <td>@(i.Actif ?? "—")</td>
                    <td><span class="badge text-bg-@(i.Ready ? "success" : "danger")">@i.StatusLabel</span></td>
                    <td class="small">@i.Reason</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
