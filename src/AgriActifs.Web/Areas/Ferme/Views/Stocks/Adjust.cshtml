@model StockArticle
@{ ViewData["Title"] = "Ajuster stock"; }
<div class="container py-4" style="max-width:560px">
    <h1 class="h3 mb-3">Ajuster — @Model.Name</h1>
    <p>Quantité actuelle : <strong>@Model.QuantityOnHand @Model.Unit</strong></p>
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Type</label>
            <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<StockMouvementType>()"></select>
        </div>
        <div class="mb-3"><label class="form-label">Quantité</label><input name="quantity" type="number" step="0.001" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Notes</label><input name="notes" class="form-control" /></div>
        <button type="submit" class="btn btn-primary">Valider</button>
        <a asp-action="Index" class="btn btn-link">Annuler</a>
    </form>
</div>
