@model IEnumerable<StockArticle>
@{ ViewData["Title"] = "Stocks"; }
<h1 class="h4 mb-3">Stocks</h1>
<ul class="list-group">
@foreach (var s in Model)
{
    var low = s.QuantityOnHand <= s.ReorderLevel;
    <li class="list-group-item d-flex justify-content-between @(low ? "list-group-item-warning" : null)">
        <div>
            <strong>@s.Name</strong>
            <div class="small text-muted">@s.Sku</div>
        </div>
        <div class="text-end">
            <strong>@s.QuantityOnHand @s.Unit</strong>
            @if (low) { <div class="small text-danger">Seuil @s.ReorderLevel</div> }
        </div>
    </li>
}
</ul>
