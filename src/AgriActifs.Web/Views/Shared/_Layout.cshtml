@using AgriActifs.Web
@using AgriActifs.Web.Models
@using AgriActifs.Web.Models.ViewModels
@using AgriActifs.Web.Options
@using Microsoft.Extensions.Options
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject AgriActifs.Web.Services.Interfaces.IAppContextService AppContext
@inject IOptions<DemoOptions> DemoOptionsAccessor
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAdmin = area == "Admin";
    var isFerme = area == "Ferme";
    var hasSidebar = isAdmin || isFerme;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var app = await AppContext.GetSnapshotAsync();
    var pageTitle = ResolvePageTitle(ViewData["Title"], app.AppName);
    var fullBleedLanding = ViewData["FullBleedLanding"] as bool? == true;
    var demo = DemoOptionsAccessor.Value;
    var isDemoMode = demo.Enabled;
    string ResolvePageTitle(object? title, string fallback)
    {
        if (title is string s && !string.IsNullOrWhiteSpace(s))
            return s;
        if (title is Microsoft.AspNetCore.Mvc.Localization.LocalizedHtmlString localized
            && !string.IsNullOrWhiteSpace(localized.Value))
            return localized.Value;
        if (title is Microsoft.AspNetCore.Html.IHtmlContent html)
        {
            using var writer = new System.IO.StringWriter();
            html.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
            var value = System.Net.WebUtility.HtmlDecode(writer.ToString());
            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }
        return fallback;
    }
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="@app.BootstrapColorMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - @app.AppName</title>
    @if (!string.IsNullOrWhiteSpace(app.LogoUrl))
    {
        <link rel="icon" href="@app.LogoUrl" />
    }
    else
    {
        <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    }
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AgriActifs.Web.styles.css" asp-append-version="true" />
    @await Component.InvokeAsync("ThemeStyle")
</head>
<body class="@(fullBleedLanding ? "page-landing" : null) @(isDemoMode ? "has-demo-banner" : null)">
    @if (isDemoMode)
    {
        <div class="demo-mode-banner" role="status">
            <div class="demo-mode-banner-inner">
                <span class="demo-mode-banner-label">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    Mode démo
                </span>
                <span class="demo-mode-banner-text">Environnement de démonstration — données fictives</span>
                <a class="demo-mode-banner-link"
                   asp-area=""
                   asp-controller="Contact"
                   asp-action="Promoteur">
                    Contacter le promoteur
                    <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    }
    <header class="app-topbar">
        <div class="app-topbar-inner">
            <div class="d-flex align-items-center gap-2">
                @if (hasSidebar)
                {
                    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Menu">
                        <i class="bi bi-list"></i>
                    </button>
                }
                @await Component.InvokeAsync("AppBranding")
                @if (isDemoMode)
                {
                    <a class="demo-mode-badge"
                       asp-area=""
                       asp-controller="Contact"
                       asp-action="Promoteur"
                       title="Contacter le promoteur">
                        DÉMO
                    </a>
                }
            </div>

            @if (!hasSidebar)
            {
                <ul class="app-nav">
                    <li>
                        <a class="app-nav-link @(controller == "Home" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> @Localizer["Nav.Home"]
                        </a>
                    </li>
                    @if (isAuthenticated)
                    {
                        <li>
                            <a class="app-nav-link"
                               asp-area="Ferme" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-tree"></i> Ferme
                            </a>
                        </li>
                        <li>
                            <a class="app-nav-link @(controller == "Profile" ? "active" : "")"
                               asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person"></i> @Localizer["Nav.Profile"]
                            </a>
                        </li>
                        <gise-permission resource="Dashboard" action="View">
                            <li>
                                <a class="app-nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-grid"></i> @Localizer["Nav.Admin"]
                                </a>
                            </li>
                        </gise-permission>
                    }
                </ul>
            }
            else if (isFerme)
            {
                <div class="app-topbar-title">@pageTitle</div>
            }

            <div class="d-flex align-items-center gap-2">
                @await Component.InvokeAsync("LanguageSelector")
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <div class="app-shell @(hasSidebar ? "has-sidebar" : "")">
        @if (isAdmin)
        {
            <aside class="app-sidebar" id="appSidebar">
                <div class="app-sidebar-label">@Localizer["Admin.Section"]</div>
                <a class="app-sidebar-link @(controller == "Dashboard" ? "active" : "")"
                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> @Localizer["Admin.Dashboard"]
                </a>
                <a class="app-sidebar-link @(controller == "Users" || controller == "UserRoles" ? "active" : "")"
                   asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i> @Localizer["Admin.Users"]
                </a>
                <a class="app-sidebar-link @(controller == "Roles" ? "active" : "")"
                   asp-area="Admin" asp-controller="Roles" asp-action="Index">
                    <i class="bi bi-person-badge"></i> @Localizer["Admin.Roles"]
                </a>
                <a class="app-sidebar-link @(controller == "Reports" ? "active" : "")"
                   asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart"></i> @Localizer["Admin.Reports"]
                </a>
                <a class="app-sidebar-link @(controller == "Audit" ? "active" : "")"
                   asp-area="Admin" asp-controller="Audit" asp-action="Index">
                    <i class="bi bi-journal-text"></i> @Localizer["Admin.Audit"]
                </a>
                <a class="app-sidebar-link @(controller == "Settings" || controller == "Themes" || controller == "Localization" ? "active" : "")"
                   asp-area="Admin" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear"></i> @Localizer["Admin.Settings"]
                </a>

                <div class="app-sidebar-label">@Localizer["Admin.SecurityDb"]</div>
                <gise-permission resource="Permissions" action="Manage">
                    <a class="app-sidebar-link @(controller == "PermissionMatrix" ? "active" : "")"
                       asp-area="Admin" asp-controller="PermissionMatrix" asp-action="Index">
                        <i class="bi bi-check2-square"></i> @Localizer["Admin.Permissions"]
                    </a>
                </gise-permission>
                <gise-permission resource="SecuredEndpoints" action="Manage">
                    <a class="app-sidebar-link @(controller == "SecuredEndpoints" ? "active" : "")"
                       asp-area="Admin" asp-controller="SecuredEndpoints" asp-action="Index">
                        <i class="bi bi-diagram-3"></i> @Localizer["Admin.Endpoints"]
                    </a>
                </gise-permission>

                <div class="app-sidebar-label mt-3">@Localizer["Admin.Account"]</div>
                <a class="app-sidebar-link" asp-controller="Profile" asp-action="Index">
                    <i class="bi bi-person-circle"></i> @Localizer["Nav.MyProfile"]
                </a>
                <a class="app-sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-arrow-left"></i> @Localizer["Admin.BackHome"]
                </a>
            </aside>
        }
        else if (isFerme)
        {
            <aside class="app-sidebar app-sidebar--ferme" id="appSidebar">
                <div class="app-sidebar-brand">
                    <span class="app-sidebar-brand-name">AgriActifs</span>
                    <span class="app-sidebar-brand-sub">Exploitation</span>
                </div>

                <div class="app-sidebar-group open" data-group="pilotage">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Pilotage</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <gise-permission resource="FermeDashboard" action="View">
                            <a class="app-sidebar-link @(controller == "Dashboard" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Tableau de bord
                            </a>
                        </gise-permission>
                        <gise-permission resource="Notifications" action="View">
                            <a class="app-sidebar-link @(controller == "Notifications" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Notifications" asp-action="Index">
                                <i class="bi bi-bell"></i> Notifications
                            </a>
                        </gise-permission>
                        <gise-permission resource="Carte" action="View">
                            <a class="app-sidebar-link @(controller == "Carte" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Carte" asp-action="Index">
                                <i class="bi bi-map"></i> Carte
                            </a>
                        </gise-permission>
                        <gise-permission resource="Terrain" action="View">
                            <a class="app-sidebar-link @(controller == "Terrain" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Terrain" asp-action="Index">
                                <i class="bi bi-phone"></i> Mode terrain
                            </a>
                        </gise-permission>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="exploitation">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Exploitation</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <gise-permission resource="Parcelles" action="View">
                            <a class="app-sidebar-link @(controller == "Parcelles" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Parcelles" asp-action="Index">
                                <i class="bi bi-grid-3x3"></i> Parcelles
                            </a>
                        </gise-permission>
                        <gise-permission resource="Activites" action="View">
                            <a class="app-sidebar-link @(controller == "Activites" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Activites" asp-action="Index">
                                <i class="bi bi-calendar3"></i> Activités
                            </a>
                        </gise-permission>
                        <gise-permission resource="Readiness" action="View">
                            <a class="app-sidebar-link @(controller == "Readiness" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Readiness" asp-action="Index">
                                <i class="bi bi-shield-check"></i> Readiness
                            </a>
                        </gise-permission>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="actifs">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Actifs</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <gise-permission resource="Actifs" action="View">
                            <a class="app-sidebar-link @(controller == "Actifs" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Actifs" asp-action="Index">
                                <i class="bi bi-truck"></i> Machines &amp; équipements
                            </a>
                        </gise-permission>
                        <gise-permission resource="Irrigation" action="View">
                            <a class="app-sidebar-link @(controller == "Irrigation" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Irrigation" asp-action="Index">
                                <i class="bi bi-droplet"></i> Irrigation
                            </a>
                        </gise-permission>
                        <gise-permission resource="Energie" action="View">
                            <a class="app-sidebar-link @(controller == "Energie" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Energie" asp-action="Index">
                                <i class="bi bi-lightning-charge"></i> Énergie
                            </a>
                        </gise-permission>
                        <gise-permission resource="Capteurs" action="View">
                            <a class="app-sidebar-link @(controller == "Capteurs" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Capteurs" asp-action="Index">
                                <i class="bi bi-broadcast"></i> Capteurs IoT
                            </a>
                        </gise-permission>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="operations">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Opérations</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <gise-permission resource="Maintenance" action="View">
                            <a class="app-sidebar-link @(controller == "Maintenance" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Maintenance" asp-action="Index">
                                <i class="bi bi-wrench"></i> Maintenance
                            </a>
                        </gise-permission>
                        <gise-permission resource="Stocks" action="View">
                            <a class="app-sidebar-link @(controller == "Stocks" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Stocks" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Stocks
                            </a>
                        </gise-permission>
                        <gise-permission resource="Fournisseurs" action="View">
                            <a class="app-sidebar-link @(controller == "Fournisseurs" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Fournisseurs" asp-action="Index">
                                <i class="bi bi-shop"></i> Fournisseurs
                            </a>
                        </gise-permission>
                        <gise-permission resource="Documents" action="View">
                            <a class="app-sidebar-link @(controller == "Documents" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Documents" asp-action="Index">
                                <i class="bi bi-folder2-open"></i> Documents
                            </a>
                        </gise-permission>
                        <gise-permission resource="RapportsFerme" action="View">
                            <a class="app-sidebar-link @(controller == "Rapports" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Rapports" asp-action="Index">
                                <i class="bi bi-graph-up"></i> Rapports
                            </a>
                        </gise-permission>
                        <gise-permission resource="Exploitations" action="View">
                            <a class="app-sidebar-link @(controller == "Exploitations" ? "active" : "")"
                               asp-area="Ferme" asp-controller="Exploitations" asp-action="Index">
                                <i class="bi bi-building"></i> Exploitations
                            </a>
                        </gise-permission>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="compte">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Compte</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <a class="app-sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> Accueil
                        </a>
                        <a class="app-sidebar-link" asp-controller="Profile" asp-action="Index">
                            <i class="bi bi-person-circle"></i> @Localizer["Nav.MyProfile"]
                        </a>
                        <gise-permission resource="Dashboard" action="View">
                            <a class="app-sidebar-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid"></i> @Localizer["Nav.Admin"]
                            </a>
                        </gise-permission>
                    </div>
                </div>
            </aside>
        }

        <main class="app-content @(fullBleedLanding ? "app-content--landing" : null)" role="main">
            @if (fullBleedLanding)
            {
                @RenderBody()
            }
            else
            {
                <div class="app-container @(isFerme ? "app-container--ferme" : null)">
                    @RenderBody()
                </div>
            }
        </main>
    </div>

    <footer class="app-footer">
        @string.Format(Localizer["Footer.Copyright"].Value, DateTime.UtcNow.Year, app.AppName)
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
